      "part": "root",
      "element": "div",
      "notes": "Modal card container. Vertical stack layout with 24px gap. Rounded-2xl border, fill bg/default, border bd/default."
    },
    {
      "part": "header",
      "element": "div",
      "notes": "Top zone with inset fill and 24px padding on all sides. Contains the title text."
    },
    {
      "part": "title",
      "element": "h2",
      "notes": "Header title text. Font: Inter/Semibold/20px, color fg/heading (cross-file var 693:171)."
    },
    {
      "part": "content",
      "element": "div",
      "notes": "Body area with bg/default fill, 24px padding, optional decorative icon (hidden by default) and label text."
    },
    {
      "part": "label",
      "element": "p",
      "notes": "Body copy text. Font: Inter/Regular/16px, color fg/default."
    },
    {
      "part": "footer",
      "element": "div",
      "notes": "Horizontal bar with space-between layout, 16px side padding, 24px top/bottom padding. Semi-transparent white fill (70% opacity) with 20px background-blur effect. Top border uses cross-file var 734:5."
    },
    {
      "part": "left-buttons",
      "element": "div",
      "notes": "Left slot for optional action buttons (visible in options-actions variant only). HUG sizing."
    },
    {
      "part": "right-buttons",
      "element": "div",
      "notes": "Right slot for primary + secondary actions. FILL in 2-actions variant, HUG in options-actions variant."
    },
    {
      "part": "button-option",
